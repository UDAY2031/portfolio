{
  "name": "gargantua-visitors",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "observability": { "enabled": false },
  "vars": { "ALLOWED_ORIGIN": "https://YOUR_DOMAIN" },
  "d1_databases": [{ "binding": "DB", "database_name": "gargantua-visitors", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["17 3 * * *"] }
}
